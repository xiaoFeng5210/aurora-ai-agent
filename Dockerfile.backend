# syntax=docker/dockerfile:1

FROM golang:1.25-bookworm AS builder

WORKDIR /src

ENV CGO_ENABLED=0 \
    GOOS=linux

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /out/aurora-backend ./main.go

FROM debian:bookworm-slim

WORKDIR /

ARG DEBIAN_FRONTEND=noninteractive

ENV TZ=Asia/Shanghai \
    GIN_MODE=release

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --shell /usr/sbin/nologin aurora \
    && mkdir -p /log \
    && chown -R aurora:aurora /log

COPY --from=builder /out/aurora-backend /aurora-backend
COPY --chown=aurora:aurora conf /conf
COPY --chown=aurora:aurora assets /assets

VOLUME ["/log"]
EXPOSE 1119

USER aurora

ENTRYPOINT ["/aurora-backend"]
