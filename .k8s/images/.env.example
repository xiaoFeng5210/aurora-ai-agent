# 复制为同目录 .env 后按自己的 ACR 填写。
#   cp .k8s/images/.env.example .k8s/images/.env
#
# 个人版：registry.cn-<region>.aliyuncs.com
# 企业版：<实例名>-registry.cn-<region>.cr.aliyuncs.com
# 地域建议和 ACK 集群相同，例如杭州：cn-hangzhou
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=ariadne

# 业务镜像版本。每次发布改这个值，不要长期只用 latest。
IMAGE_TAG=v0.0.1

# 基础镜像 tag，与仓库根目录 docker-compose.yml 对齐
POSTGRES_TAG=16-alpine
REDIS_TAG=7-alpine
RABBITMQ_TAG=3.13-management-alpine
